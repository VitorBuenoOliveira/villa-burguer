# ===== CONFIGURAÇÕES DO SERVIDOR =====
NODE_ENV=production
PORT=4000

# ===== SEGURANÇA (JWT) =====
# Gere uma chave forte de no mínimo 32 caracteres (ex: openssl rand -base64 32)
SECRET_KEY=insira_aqui_sua_chave_secreta_jwt_para_producao_minimo_32_chars

# ===== GATEWAY DE PAGAMENTOS (MERCADO PAGO) =====
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=APP_USR-seu_access_token_aqui
MP_WEBHOOK_SECRET=seu_webhook_secret_aqui
PUBLIC_KEY=APP_USR-sua_public_key_aqui

# ===== LOGS & CORS =====
CLIENT_ORIGIN=https://seudominio.com.br
